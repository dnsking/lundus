{
  "manifest_version": 2,
  "name": "tvbro-generic",
  "version": "1.2",
  "description": "TV Bro Generic Addon",
  "browser_specific_settings": {
    "gecko": {
      "id": "tvbro@mock.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["generic.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://tv.io.co.zm/*", "*://*/appcontent/home/*"],
      "js": ["home.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
